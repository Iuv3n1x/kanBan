# http://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Specific overrides for web files (HTML, CSS, JS, TS)
[*.{html,css,scss,less,js,jsx,ts,tsx,json}]
indent_size = 4

# Make Makefiles use tabs instead of spaces (standard requirement)
[Makefile]
indent_style = tab

# Markdown files often benefit from standard spaces without strict trailing whitespace trimming
[*.md]
trim_trailing_whitespace = false
